# Copy to .env and fill in EVERY value. Never commit the real file.

# --- Where Quanta is reachable (Caddy gets a certificate for this name automatically) ---
QUANTA_DOMAIN=quanta.yourcompany.com

# --- Secrets: generate each one, do not invent them ---
# python cli/quanta_admin.py gen-secret          -> QUANTA_SESSION_SECRET (keeps users signed in across restarts)
# python cli/quanta_admin.py gen-key             -> QUANTA_ENCRYPTION_KEY (encrypts stored scanner credentials)
# Keep a copy of the encryption key somewhere safe and separate: backups do NOT contain it,
# and without it stored credentials cannot be decrypted.
QUANTA_SESSION_SECRET=
QUANTA_ENCRYPTION_KEY=
QUANTA_DB_PASSWORD=

# --- First administrator (used only when no admin exists; change the password after signing in) ---
QUANTA_BOOTSTRAP_ADMIN_EMAIL=you@yourcompany.com
QUANTA_ADMIN_PASSWORD=

# --- Optional ---
# Bearer token that turns on /metrics (Prometheus). Leave empty to keep it off.
QUANTA_METRICS_TOKEN=
# Vendor support desk address for admin-confirmed ticket escalation by email.
QUANTA_SUPPORT_EMAIL=
# Email for scheduled reports, alerts and SLA escalation. Leave empty to record them in-app only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
