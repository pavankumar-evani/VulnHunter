# Real environment variables this application actually reads - every one listed here
# is checked with os.environ.get() somewhere in dashboard/, remediation/, or cli/ (see
# the file:line citations below). Copy this to `.env` and fill in real values, or set
# these directly in your process manager/container - this app does not load a `.env`
# file itself (no python-dotenv dependency), so use whatever your deployment already
# uses to set process environment variables.
#
# Nothing in this file is a real secret - every value below is either empty or an
# obviously-fake placeholder. Never commit a real secret to this file or any other.

# --- Session / auth (dashboard/auth/rbac.py) -------------------------------------
# Required before any real deployment. Without it, a random secret is generated fresh
# every process start - every session is invalidated on restart, and multiple worker
# processes mint mutually incompatible cookies. Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
VULNHUNTER_SESSION_SECRET=

# Opt-in: require a valid session on every /api/* route (not just mutations) - closes
# the "anonymous reads see everything" gap documented in dashboard/README.md. Also
# closes the one caveat on per-team RBAC (an anonymous request otherwise bypasses
# _scope_to_team() the same way it bypasses everything else). Requires
# VULNHUNTER_SESSION_SECRET above to be set too, or the app refuses to start.
VULNHUNTER_REQUIRE_LOGIN_FOR_READS=false

# --- HTTPS (dashboard/app.py __main__ - local dev only) ---------------------------
# Opt-in local-dev TLS via uvicorn's own SSL support. A real deployment should
# terminate TLS at a reverse proxy instead (see dashboard/README.md's nginx example) -
# leave these unset in that case.
SSL_KEYFILE=
SSL_CERTFILE=

# --- SMTP / email (remediation/notifications/email_sender.py) --------------------
# All required together for scheduled-report/team-alert emails to actually send;
# leave all blank to leave email disabled (dashboard/app.py's /api/status reports
# smtp_configured: false honestly rather than failing loudly).
SMTP_HOST=
SMTP_PORT=
SMTP_FROM_ADDRESS=
# Optional - omit for an anonymous relay that doesn't require auth.
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional, defaults to "1" (STARTTLS on). Set to "0"/"false"/"no" to disable.
SMTP_USE_TLS=1

# --- Active Directory / LDAP (dashboard/auth/ad_directory.py) --------------------
# Required together for real AD group-membership validation on Remediation Approvals.
# Read-only - never creates/modifies/resets an AD object. Leave blank to leave this
# disabled (approvals proceed with ad_group_validated: null, never faked as pass/fail).
AD_SERVER=
AD_BASE_DN=
# Optional - anonymous LDAP bind is used if these are blank (most real ADs require
# an authenticated bind though).
AD_BIND_USER=
AD_BIND_PASSWORD=

# --- OIDC / SSO (dashboard/auth/oidc.py) ------------------------------------------
# Required together to enable "Sign in with SSO" - the login page hides that button
# entirely unless all four of these are set to real values.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# Optional, cosmetic only - label on the "Sign in with SSO" button.
OIDC_PROVIDER_NAME=SSO

# --- Notification scheduler (dashboard/app.py) ------------------------------------
# Optional tuning - how often (seconds) the in-process scheduler checks for due
# scheduled reports / team alerts. Defaults to 3600 (hourly) if unset.
NOTIFICATION_CHECK_INTERVAL_SECONDS=3600

# --- Claude CLI (cli/vulnhunter.py) -----------------------------------------------
# Optional - only needed if the `claude` binary isn't already on PATH.
CLAUDE_BIN=

# --- Live threat-intel connectors (remediation/connectors/fetch_live_data.py) -----
# Required (per source) only if actually running fetch_live_data.py against a real
# Tenable.io or Armis tenant - the bundled sample data needs none of these.
TENABLE_ACCESS_KEY=
TENABLE_SECRET_KEY=
ARMIS_SECRET_KEY=
ARMIS_BASE_URL=
