vulnerable-demo-app/venv/
vulnerable-demo-app/vulnshop.db
vulnerable-demo-app/.env
**/__pycache__/
*.pyc

# CLI audit logs are runtime output (may include scan results) - not source, don't commit
.vulnhunter/

# Live-fetched Tenable/Armis data is real vulnerability data about real infrastructure -
# never commit it, unlike the fabricated remediation/sample-data/
remediation/live-data/

# Raw NVD API response cache for generate_bulk_findings.py - large (tens of MB), purely
# a local speed-up for re-running the generator, not meaningful data itself. The derived
# bulk_*.csv/json fixture files (committed) are what matters.
remediation/sample-data/bulk/_nvd_cache/

# Real activity audit log (remediation/audit/activity_log.py) - runtime output from
# actually using the app (who did what, when), not seed/reference data - same reasoning
# as .vulnhunter/ above. The activity_log.py module itself is still committed.
remediation/audit/activity_log.json

# Real AI-call usage log (remediation/audit/ai_usage_log.py) - same reasoning as
# activity_log.json above.
remediation/audit/ai_usage_log.json
