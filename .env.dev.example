# DEV settings for docker-compose.dev.yml. Placeholders only: nothing here is a real secret. Use a dev vault, never production values.
QUANTA_ENV=dev
QUANTA_VERSION=1.0.0
QUANTA_DB_PASSWORD=dev-only-change-me
QUANTA_SESSION_SECRET=dev-only-session-secret-change-me-0123456789
QUANTA_ENCRYPTION_KEY=
QUANTA_DOMAIN=localhost
QUANTA_FEATURES_ON=
QUANTA_ALLOW_SIMULATION=true
